{
  "name": "pc-digital-twin",
  "private": true,
  "description": "True-scale 3D digital twin of a gaming PC: parts, power, heat and airflow what-if lab.",
  "license": "GPL-3.0-or-later",
  "author": "Osvaldo Margato (https://github.com/margato)",
  "keywords": [
    "three.js",
    "react-three-fiber",
    "digital-twin",
    "pc-hardware",
    "3d"
  ],
  "version": "11.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
